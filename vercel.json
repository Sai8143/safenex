{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/backend/app/static/dashboard.html"
    },
    {
      "src": "/hospital",
      "dest": "/backend/app/static/hospital.html"
    },
    {
      "src": "/police",
      "dest": "/backend/app/static/police.html"
    },
    {
      "src": "/ambulance",
      "dest": "/backend/app/static/ambulance.html"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/app/static/$1"
    }
  ]
}
